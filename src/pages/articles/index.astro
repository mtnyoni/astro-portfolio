---
import { getCollection } from "astro:content"
import Layout from "@layouts/base-layout.astro"
import { ArrowLeftIcon } from "@lucide/astro"

const posts = (await getCollection("articles", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	})
---

<Layout title="Articles">
	<main
		class="leading-body text-body-copy mx-auto max-w-190 px-7 pt-12 pb-16 text-sm max-sm:max-w-125 max-sm:px-6 max-sm:pt-8"
	>
		<div class="py-6">
			<a
				href="/"
				class="ease-standard hover:text-link-hover inline-flex items-center gap-2 text-xs text-mist-500 transition-colors duration-200 motion-reduce:transition-none"
			>
				<ArrowLeftIcon class="size-4" />
				Portfolio
			</a>
		</div>

		<header class="pb-10 sm:ml-33.5">
			<h1
				class="mb-2 text-2xl leading-[1.1] font-normal tracking-[-0.04em] text-mist-700"
			>
				Articles
			</h1>
			<p>My two cents on how good software is engineered.</p>
		</header>

		<ol>
			{
				posts.map((post) => (
					<li class="sm:grid-cols-portfolio before:bg-separator after:size-i.75 relative grid gap-1 pb-9 before:absolute before:top-2.5 before:left-0.75 before:h-full before:w-px after:absolute after:top-1.5 after:left-0 after:rounded-full after:bg-mist-500 last:pb-0 last:before:hidden sm:gap-6">
						<time
							class="text-section-label pt-0.75 pl-5 text-xs tabular-nums"
							datetime={post.data.pubDate.toISOString()}
						>
							{formatDate(post.data.pubDate)}
						</time>
						<div class="min-w-0 max-sm:pl-5">
							<a
								href={`/articles/${post.id}/`}
								class="ease-standard hover:text-link-hover font-medium text-mist-700 transition-colors duration-200 motion-reduce:transition-none"
							>
								{post.data.title}
							</a>
							<p class="mt-1 line-clamp-2 text-xs">
								{post.data.description}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</main>
</Layout>
