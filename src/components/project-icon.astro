---
import rentalIcon from "@assets/renteazy-icon.svg?url"
import financeIcon from "@assets/goodhabits-icon.svg?url"

interface Props {
	kind: "rental" | "finance"
}
const { kind } = Astro.props
---

<span
	class="block size-12 shrink-0 rounded-[10px] border border-[#c9d0d4] bg-[linear-gradient(145deg,#ffffff,#edf1f3)] p-1 shadow-[inset_0_0_0_1px_#ffffff,inset_0_1px_0_#ffffff,0_1px_2px_#283d4626]"
	aria-hidden="true"
>
	<img
		class="block size-full"
		src={kind === "rental" ? rentalIcon : financeIcon}
		alt=""
		width="48"
		height="48"
	/>
</span>
