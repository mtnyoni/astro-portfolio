---
import { MyChart, manCityMatchHistory } from "@components/line-chart"
import CraftsLayout from "@layouts/crafts-layout.astro"
---

<CraftsLayout>
	<div class="text-lg font-medium">Line chart</div>
	<div class="border-border mt-4 rounded-3xl border bg-white p-4 sm:p-8">
		<MyChart data={manCityMatchHistory} client:load />
	</div>
	<div class="flex items-center justify-end py-8">
		<a href="/crafts/samsung-notifications" class="block">
			<div class="text-gray-600">Next</div>
			<div class="text-sm">Samsung Notifications</div>
		</a>
	</div>
</CraftsLayout>
