{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"semi": false,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"quoteProps": "as-needed",
	"endOfLine": "lf",
	"trailingComma": "es5",
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		}
	],
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"]
}
