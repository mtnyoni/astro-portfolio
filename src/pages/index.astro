---
import BaseLayout from "@layouts/base-layout.astro"
import HeroTitle from "@components/hero-title"
import chart from "@assets/line-chart.png"
import notifications from "@assets/samsung-notifications.mp4"
import notificationPoster from "@assets/samsung-notifications-preview.jpg"
import { projects } from "@utils/constants"
import { ArrowUpRight } from "@lucide/astro"
import ProjectIcon from "@components/project-icon.astro"
---

<BaseLayout>
	<main id="top" class="portfolio">
		<header class="intro">
			<HeroTitle client:load />
			<div class="intro-copy">
				<p>
					I’m <strong>Tawanda M. Nyoni</strong>, Software Engineer and
					UI/UX Designer. I care <br /> about how products look, feel, and
					work.
				</p>
				<p>
					<strong>Senior Software Developer</strong> at <strong
						>Claxon Business Solutions</strong
					>. Working across <br /> engineering and design to make complex
					things feel simple.
				</p>
				<p>
					Linux fanatic. Writing Odin, Go, Python, and TypeScript.
					Always exploring.
				</p>
			</div>
			<nav aria-label="Portfolio sections">
				<a href="#work">Work</a>
				<a href="#craft">Craft</a>
				<a href="#writing">Writing</a>
				<span aria-hidden="true">|</span>
				<a href="#connect">Connect <ArrowUpRight size={13} /></a>
			</nav>
		</header>

		<section id="work" class="section" aria-labelledby="work-title">
			<h2 id="work-title">Selected work</h2>
			<div class="section-content project-list">
				{
					projects.map((project, index) => (
						<a
							class="project-row"
							href={project.link}
							target="_blank"
							rel="noopener noreferrer"
						>
							<ProjectIcon
								kind={index === 0 ? "rental" : "finance"}
							/>
							<span class="project-copy">
								<>
									<span class="link-title">
										{project.title}{" "}
										<ArrowUpRight size={13} />
									</span>
									<span class="description">
										{project.description}
									</span>
								</>
							</span>
							<span class="year">{project.year}</span>
						</a>
					))
				}
			</div>
		</section>

		<section id="craft" class="section" aria-labelledby="craft-title">
			<h2 id="craft-title">Craft</h2>
			<div class="section-content">
				<p class="section-intro">
					Little experiments exploring how designs come about, and
					laying out my imagination.
				</p>
				<div class="studies">
					<a class="study" href="/crafts/line-chart">
						<div class="study-visual chart-visual">
							<img
								src={chart.src}
								width={chart.width}
								height={chart.height}
								alt="Interactive line chart with a soft green area fill"
								loading="lazy"
							/><span class="open-study"
								><ArrowUpRight size={15} /></span
							>
						</div>
						<div class="study-caption">
							<h3>Animated line chart</h3><span
								>Data, with a little life.</span
							>
						</div>
					</a>
					<div class="study">
						<div class="study-visual phone-visual">
							<video
								id="notification-preview"
								poster={notificationPoster.src}
								src={notifications}
								muted
								loop
								playsinline
								preload="metadata"
								aria-label="Samsung notification animation preview"
							></video><button
								id="preview-toggle"
								type="button"
								aria-controls="notification-preview"
								aria-pressed="false"
								>Play preview <span aria-hidden="true">▷</span
								></button
							>
						</div>
						<a
							class="study-caption"
							href="/crafts/samsung-notifications"
							><h3>
								Samsung notifications <ArrowUpRight size={13} />
							</h3><span>A study in motion & feedback.</span></a
						>
					</div>
				</div>
			</div>
		</section>

		<section id="writing" class="section" aria-labelledby="writing-title">
			<h2 id="writing-title">Writing</h2>
			<div class="section-content">
				<a
					class="writing-link"
					href="/articles/how-to-learn-a-new-programming-language-or-framework"
					><span
						><h3>
							How to learn a new programming language or framework
						</h3><p>Looking beyond the syntax.</p></span
					><ArrowUpRight size={17} /></a
				>
			</div>
		</section>

		<section id="connect" class="section" aria-labelledby="connect-title">
			<h2 id="connect-title">Elsewhere</h2>
			<div class="section-content">
				<p>
					Have something in mind, or just want to say hello?<br />I’d
					love to hear from you.
				</p><div class="social-links">
					<a
						href="https://github.com/mtnyoni"
						target="_blank"
						rel="noopener noreferrer"
						>GitHub <ArrowUpRight size={12} /></a
					><a
						href="https://linkedin.com/in/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
						>LinkedIn <ArrowUpRight size={12} /></a
					><a
						href="https://x.com/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
						>X / Twitter <ArrowUpRight size={12} /></a
					>
				</div>
			</div>
		</section>
		<footer>
			<span>© {new Date().getFullYear()} Tawanda Nyoni</span><a
				href="#top">Back to top ↑</a
			>
		</footer>
	</main>
</BaseLayout>

<script>
	const video = document.querySelector<HTMLVideoElement>(
		"#notification-preview"
	)
	const toggle = document.querySelector<HTMLButtonElement>("#preview-toggle")
	if (video && toggle) {
		const update = () => {
			toggle.setAttribute("aria-pressed", String(!video.paused))
			toggle.innerHTML = video.paused
				? 'Play preview <span aria-hidden="true">▷</span>'
				: 'Pause preview <span aria-hidden="true">Ⅱ</span>'
		}
		toggle.addEventListener("click", async () => {
			if (video.paused) {
				try {
					await video.play()
				} catch {
					toggle.textContent = "Preview unavailable"
				}
			} else video.pause()
		})
		video.addEventListener("play", update)
		video.addEventListener("pause", update)
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) video.pause()
		})
	}
</script>

<style>
	.portfolio {
		max-width: 760px;
		margin: 0 auto;
		padding: 96px 28px 32px;
		font-size: 14px;
		line-height: 1.7;
		color: #626a6c;
	}
	.intro {
		margin-left: 134px;
		padding-bottom: 52px;
	}
	.intro-copy p + p {
		margin-top: 18px;
	}
	strong {
		color: #303839;
		font-weight: 500;
	}
	nav {
		display: flex;
		gap: 22px;
		margin-top: 26px;
		font-size: 12px;
		color: #41494b;
	}
	nav a {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	nav > span {
		color: #b5bcbc;
	}
	.section {
		display: grid;
		grid-template-columns: 110px minmax(0, 1fr);
		gap: 24px;
		padding: 30px 0;
		scroll-margin-top: 32px;
	}
	h2 {
		font-size: 12px;
		font-weight: 400;
		color: #7a8284;
		padding-top: 3px;
	}
	.section-content {
		min-width: 0;
	}
	.project-list {
		margin-top: -10px;
	}
	.project-row {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px 10px;
		margin: 0 -10px;
		border-radius: 10px;
		transition: background 0.2s;
	}
	.project-row:hover {
		background: #e8eded;
	}
	.project-copy {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}
	.link-title {
		color: #303839;
		font-weight: 500;
		display: flex;
		gap: 6px;
		align-items: center;
	}
	.link-title svg {
		color: #8c9596;
	}
	.description {
		font-size: 12px;
	}
	.year {
		margin-left: auto;
		color: #858d8f;
		font-size: 11px;
		font-variant-numeric: tabular-nums;
	}
	.section-intro {
		margin-bottom: 20px;
		max-width: 410px;
	}
	.studies {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.study-visual {
		height: 200px;
		position: relative;
		overflow: hidden;
		border: 1px solid #dfe5e4;
		border-radius: 12px;
	}
	.chart-visual {
		display: grid;
		place-items: center;
		background: #e7ece9;
		padding: 18px;
	}
	.chart-visual img {
		width: 100%;
		border-radius: 5px;
		box-shadow: 0 8px 24px #35493d12;
		transition: transform 0.3s;
	}
	.study:hover .chart-visual img {
		transform: translateY(-3px);
	}
	.open-study {
		position: absolute;
		right: 10px;
		bottom: 10px;
		color: #798580;
	}
	.phone-visual {
		background: #e6e9ed;
	}
	.phone-visual video {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	#preview-toggle {
		position: absolute;
		bottom: 10px;
		left: 10px;
		display: flex;
		gap: 14px;
		align-items: center;
		padding: 5px 9px;
		border-radius: 6px;
		color: #394142;
		background: #ffffffed;
		box-shadow: 0 1px 4px #0001;
		font-size: 10px;
		cursor: pointer;
	}
	.study-caption {
		display: block;
		padding-top: 12px;
	}
	h3 {
		font-size: 13px;
		font-weight: 500;
		line-height: 1.55;
		color: #303839;
	}
	.study-caption h3 {
		display: flex;
		align-items: center;
		gap: 5px;
	}
	.study-caption > span {
		font-size: 11px;
	}
	.writing-link {
		display: flex;
		gap: 20px;
		align-items: center;
	}
	.writing-link > svg {
		flex-shrink: 0;
		margin-left: auto;
	}
	.writing-link p {
		font-size: 12px;
		margin-top: 5px;
	}
	.social-links {
		display: flex;
		gap: 22px;
		flex-wrap: wrap;
		margin-top: 20px;
	}
	.social-links a {
		display: flex;
		gap: 6px;
		align-items: center;
		color: #414b4c;
		font-size: 12px;
	}
	footer {
		margin: 40px 0 0 134px;
		padding-top: 20px;
		border-top: 1px solid #dce2e2;
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font-size: 10px;
		color: #828b8c;
	}
	a {
		transition: color 0.2s;
	}
	a:hover {
		color: #151c1d;
	}
	@media (max-width: 640px) {
		.portfolio {
			padding: 48px 24px 24px;
			max-width: 500px;
		}
		.intro {
			margin-left: 0;
			padding-bottom: 22px;
		}
		.section {
			grid-template-columns: 1fr;
			gap: 17px;
			padding: 26px 0;
		}
		h2 {
			color: #414b4c;
			font-weight: 500;
		}
		footer {
			margin-left: 0;
		}
		.study-visual {
			height: 180px;
		}
	}
	@media (max-width: 380px) {
		.studies {
			grid-template-columns: 1fr;
		}
		.study-visual {
			height: 220px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		a,
		.project-row,
		.chart-visual img {
			transition: none;
		}
		.study:hover .chart-visual img {
			transform: none;
		}
	}
</style>
