---
import { SamsungPhone } from "@components/samsung-phone-craft"
import CraftsLayout from "@layouts/crafts-layout.astro"
---

<CraftsLayout>
	<div class="text-lg font-medium">Samsung Notifications</div>
	<div class="border-border mt-4 h-101.5 overflow-hidden rounded-3xl border bg-white px-4 pt-4 sm:h-105 sm:px-8 sm:pt-8">
		<SamsungPhone client:only="react">
			<p
				slot="fallback"
				role="status"
				class="text-body-copy text-center text-xs"
			>
				Loading notifications…
			</p>
		</SamsungPhone>
	</div>
</CraftsLayout>
