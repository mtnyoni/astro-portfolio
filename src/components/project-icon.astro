---
import rentalIcon from "@assets/renteazy-icon.svg?url"
import financeIcon from "@assets/goodhabits-icon.svg?url"

interface Props {
	kind: "rental" | "finance"
}
const { kind } = Astro.props
---

<span
	class="rounded-project block size-10 shrink-0 border border-mist-300 bg-[linear-gradient(145deg,#ffffff,var(--color-mist-100))] p-1 shadow-[inset_0_0_0_1px_#ffffff,inset_0_1px_0_#ffffff,0_1px_2px_#24303226]"
	aria-hidden="true"
>
	<img
		class="block size-full"
		src={kind === "rental" ? rentalIcon : financeIcon}
		alt=""
		width="48"
		height="48"
	/>
</span>
