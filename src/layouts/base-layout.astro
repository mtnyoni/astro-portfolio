---
import "../styles/global.css"

const schema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Tawanda M Nyoni",
	url: "https://tmnyoni.site",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Harare",
		addressCountry: "ZW",
	},
	jobTitle: "Senior Software Developer",
	worksFor: { "@type": "Organization", name: "Claxon Business Solutions" },
	sameAs: [
		"https://github.com/mtnyoni",
		"https://linkedin.com/in/tmnyoni",
		"http://x.com/tmnyoni",
	],
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Tawanda Nyoni — Software Developer & Interface Designer</title>

		<meta
			name="description"
			content="Tawanda Nyoni is a software developer and interface designer based in Harare, Zimbabwe, building considered digital products."
		/>
		<meta property="og:type" content="profile" />
		<meta
			property="og:title"
			content="Tawanda Nyoni — Software Developer & Interface Designer"
		/>
		<meta
			property="og:description"
			content="Selected work, interface studies, and writing by Tawanda Nyoni."
		/>
		<meta property="og:url" content="https://tmnyoni.site" />
		<meta property="og:locale" content="en_ZW" />

		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(schema)}
		/>
	</head>
	<body class="relative">
		<div class="relative z-10 min-h-screen">
			<slot />
		</div>
	</body>
</html>
