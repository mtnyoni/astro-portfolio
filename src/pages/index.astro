---
import BaseLayout from "@layouts/base-layout.astro"
import HeroTitle from "@components/hero-title"
import chart from "@assets/line-chart.png"
import notifications from "@assets/samsung-notifications.mp4"
import notificationPoster from "@assets/samsung-notifications-preview.jpg"
import { projects } from "@utils/constants"
import { ArrowUpRight } from "@lucide/astro"
import ProjectIcon from "@components/project-icon.astro"
---

<BaseLayout>
	<main
		id="top"
		class="mx-auto max-w-190 px-7 pt-24 pb-8 text-[14px] leading-[1.7] text-[#626a6c] [@media(max-width:640px)]:max-w-125 [@media(max-width:640px)]:px-6 [@media(max-width:640px)]:pt-12 [@media(max-width:640px)]:pb-6"
	>
		<header
			class="ml-33.5 pb-13 [@media(max-width:640px)]:ml-0 [@media(max-width:640px)]:pb-5.5"
		>
			<HeroTitle client:load />
			<div class="[&_p+p]:mt-4.5">
				<p>
					I’m <strong class="font-medium text-mist-700"
						>Tawanda M. Nyoni</strong
					>, Software Engineer and UI/UX Designer. I care <br /> about how
					products look, feel, and work.
				</p>
				<p>
					<strong class="font-medium text-mist-700">
						Senior Software Developer
					</strong>
					at
					<strong class="font-medium text-mist-700">
						Claxon Business Solutions
					</strong>
					. Working across <br /> engineering and design to make complex
					things feel simple.
				</p>
				<p>
					Linux fanatic. Writing Odin, Go, Python, and TypeScript.
					Always exploring.
				</p>
			</div>
			<nav
				class="mt-6.5 flex gap-5.5 text-[12px] text-[#41494b] [&_a]:flex [&_a]:items-center [&_a]:gap-1 [&>span]:text-[#b5bcbc]"
				aria-label="Portfolio sections"
			>
				<a
					class="transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
					href="#work">Work</a
				>
				<a
					class="transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
					href="#craft">Craft</a
				>
				<a
					class="transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
					href="#writing">Writing</a
				>
				<span aria-hidden="true">|</span>
				<a
					class="transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
					href="#connect">Connect <ArrowUpRight size={13} /></a
				>
			</nav>
		</header>

		<section
			id="work"
			class="grid scroll-mt-8 grid-cols-[110px_minmax(0,1fr)] gap-6 py-7.5 [@media(max-width:640px)]:grid-cols-1 [@media(max-width:640px)]:gap-4.25 [@media(max-width:640px)]:py-6.5"
			aria-labelledby="work-title"
		>
			<h2
				class="pt-0.75 text-[12px] font-normal text-[#7a8284] [@media(max-width:640px)]:font-medium [@media(max-width:640px)]:text-[#414b4c]"
				id="work-title"
			>
				Selected work
			</h2>
			<div class="-mt-2.5 min-w-0">
				{
					projects.map((project, index) => (
						<a
							class="-mx-2.5 flex items-center gap-3.5 rounded-[10px] px-2.5 py-3 transition-colors duration-200 ease-[ease] hover:bg-[#e8eded] hover:text-[#151c1d] motion-reduce:transition-none"
							href={project.link}
							target="_blank"
							rel="noopener noreferrer"
						>
							<ProjectIcon
								kind={index === 0 ? "rental" : "finance"}
							/>
							<span class="flex flex-col gap-px">
								<>
									<span class="flex items-center gap-1.5 font-medium text-mist-700 [&_svg]:text-[#8c9596]">
										{project.title}{" "}
										<ArrowUpRight size={13} />
									</span>
									<span class="text-[12px]">
										{project.description}
									</span>
								</>
							</span>
							<span class="ml-auto text-[11px] text-[#858d8f] tabular-nums">
								{project.year}
							</span>
						</a>
					))
				}
			</div>
		</section>

		<section
			id="craft"
			class="grid scroll-mt-8 grid-cols-[110px_minmax(0,1fr)] gap-6 py-7.5 [@media(max-width:640px)]:grid-cols-1 [@media(max-width:640px)]:gap-4.25 [@media(max-width:640px)]:py-6.5"
			aria-labelledby="craft-title"
		>
			<h2
				class="pt-0.75 text-[12px] font-normal text-[#7a8284] [@media(max-width:640px)]:font-medium [@media(max-width:640px)]:text-[#414b4c]"
				id="craft-title"
			>
				Craft
			</h2>
			<div class="min-w-0">
				<p class="mb-5 max-w-102.5">
					Little experiments exploring how designs come about, and
					laying out my imagination.
				</p>
				<div
					class="grid grid-cols-2 gap-1 [@media(max-width:380px)]:grid-cols-1"
				>
					<a
						class="group transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
						href="/crafts/line-chart"
					>
						<div
							class="relative grid h-50 place-items-center overflow-hidden rounded-xl bg-[#e7ece9] [@media(max-width:380px)]:h-55 [@media(max-width:640px)]:h-45"
						>
							<div
								class="absolute inset-1 overflow-hidden rounded-lg"
							>
								<img
									class="h-full w-full rounded-lg object-cover transition-transform duration-300 ease-[ease] motion-safe:group-hover:scale-105 motion-reduce:transition-none"
									src={chart.src}
									width={chart.width}
									height={chart.height}
									alt="Interactive line chart with a soft green area fill"
									loading="lazy"
								/>
							</div>
						</div>
						<div
							class="block pt-1 [&_h3]:flex [&_h3]:items-center [&_h3]:gap-1.25 [&>span]:text-[11px]"
						>
							<h3 class="text-xs text-mist-500">
								Animated line chart
							</h3>
						</div>
					</a>
					<div class="group">
						<div
							class="relative h-50 overflow-hidden rounded-xl border border-[#dfe5e4] bg-[#e6e9ed] [@media(max-width:380px)]:h-[220px] [@media(max-width:640px)]:h-[180px]"
						>
							<div
								class="absolute inset-1 overflow-hidden rounded-lg"
							>
								<video
									class="size-full rounded-lg object-cover"
									id="notification-preview"
									poster={notificationPoster.src}
									src={notifications}
									muted
									loop
									playsinline
									preload="metadata"
									aria-label="Samsung notification animation preview"
								>
								</video>
								<button
									class="absolute bottom-2.5 left-2.5 flex cursor-pointer items-center gap-3.5 rounded-md bg-[#ffffffed] px-[9px] py-[5px] text-[10px] text-[#394142] shadow-[0_1px_4px_#0001]"
									id="preview-toggle"
									type="button"
									aria-controls="notification-preview"
									aria-pressed="false"
									>Play preview <span aria-hidden="true"
										>▷</span
									>
								</button>
							</div>
						</div>
						<a
							class="block pt-1 transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none [&_h3]:flex [&_h3]:items-center [&_h3]:gap-[5px] [&>span]:text-[11px]"
							href="/crafts/samsung-notifications"
						>
							<h3 class="text-xs text-mist-500">
								Samsung notifications
							</h3>
						</a>
					</div>
				</div>
			</div>
		</section>

		<section
			id="writing"
			class="grid scroll-mt-8 grid-cols-[110px_minmax(0,1fr)] gap-6 py-7.5 [@media(max-width:640px)]:grid-cols-1 [@media(max-width:640px)]:gap-[17px] [@media(max-width:640px)]:py-[26px]"
			aria-labelledby="writing-title"
		>
			<h2
				class="pt-0.75 text-[12px] font-normal text-[#7a8284] [@media(max-width:640px)]:font-medium [@media(max-width:640px)]:text-[#414b4c]"
				id="writing-title"
			>
				Writing
			</h2>
			<div class="min-w-0">
				<p class="mb-2 max-w-102.5">
					My two cents on how good software is engineered.
				</p>
				<a
					class="flex items-center gap-5 transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none [&_p]:mt-[5px] [&_p]:text-[12px] [&>svg]:ml-auto [&>svg]:shrink-0"
					href="/articles/how-to-learn-a-new-programming-language-or-framework"
				>
					<div class="-space-y-1.5">
						<h3
							class="text-sm leading-[1.55] font-medium text-mist-700"
						>
							How to learn a new programming language or framework
						</h3>
						<p>Looking beyond the syntax.</p>
					</div>
					<ArrowUpRight size={17} />
				</a>
			</div>
		</section>

		<section
			id="connect"
			class="grid scroll-mt-8 grid-cols-[110px_minmax(0,1fr)] gap-6 py-7.5 [@media(max-width:640px)]:grid-cols-1 [@media(max-width:640px)]:gap-[17px] [@media(max-width:640px)]:py-[26px]"
			aria-labelledby="connect-title"
		>
			<h2
				class="pt-0.75 text-[12px] font-normal text-[#7a8284] [@media(max-width:640px)]:font-medium [@media(max-width:640px)]:text-[#414b4c]"
				id="connect-title"
			>
				Elsewhere
			</h2>
			<div class="min-w-0">
				<p>
					Have something in mind, or big ideas that need to be turned
					<br /> into reality? Hit me up.
				</p>
				<div
					class="mt-3 flex flex-wrap gap-5.5 [&_a]:flex [&_a]:items-center [&_a]:gap-1.5 [&_a]:text-[12px] [&_a]:text-[#414b4c] [&_a:hover]:text-[#151c1d]"
				>
					<a
						class="transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
						href="https://github.com/mtnyoni"
						target="_blank"
						rel="noopener noreferrer"
					>
						GitHub
						<ArrowUpRight size={12} />
					</a>
					<a
						class="transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
						href="https://linkedin.com/in/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
					>
						LinkedIn
						<ArrowUpRight size={12} />
					</a>
					<a
						class="transition-colors duration-200 ease-[ease] hover:text-[#151c1d] motion-reduce:transition-none"
						href="https://x.com/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
					>
						X.com
						<ArrowUpRight size={12} />
					</a>
				</div>
			</div>
		</section>
		<footer
			class="mt-10 ml-33.5 flex justify-between gap-4 border-t border-[#dce2e2] pt-5 text-[10px] text-[#828b8c] [@media(max-width:640px)]:ml-0"
		>
			<span>© {new Date().getFullYear()} Tawanda Nyoni</span>
		</footer>
	</main>
</BaseLayout>

<script>
	const video = document.querySelector<HTMLVideoElement>(
		"#notification-preview"
	)
	const toggle = document.querySelector<HTMLButtonElement>("#preview-toggle")
	if (video && toggle) {
		const update = () => {
			toggle.setAttribute("aria-pressed", String(!video.paused))
			toggle.innerHTML = video.paused
				? 'Play preview <span aria-hidden="true">▷</span>'
				: 'Pause preview <span aria-hidden="true">Ⅱ</span>'
		}
		toggle.addEventListener("click", async () => {
			if (video.paused) {
				try {
					await video.play()
				} catch {
					toggle.textContent = "Preview unavailable"
				}
			} else video.pause()
		})
		video.addEventListener("play", update)
		video.addEventListener("pause", update)
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) video.pause()
		})
	}
</script>
