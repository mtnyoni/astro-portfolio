---
import { getCollection } from "astro:content"
import Layout from "@layouts/base-layout.astro"
import { ArrowLeftIcon } from "@lucide/astro"

const posts = (await getCollection("articles", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<Layout title="Articles">
	<div class="mx-auto mt-6 max-w-190 font-sans">
		<div class="flex items-center gap-10 py-8">
			<a href="/" class="flex items-center gap-2 text-xs text-mist-500">
				<ArrowLeftIcon class="size-4" />
				Portfolio
			</a>
		</div>
		<div class="font-medium">Articles</div>
		<ul class="mt-3 space-y-3">
			{
				posts.map((post) => (
					<li>
						<a href={`/articles/${post.id}/`} class="text-mist-700">
							{post.data.title}
						</a>
						<p class="max-w-180 truncate text-sm text-mist-500">
							{post.data.description}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</Layout>
