---
import BaseLayout from "@layouts/base-layout.astro"
import portraitUrl from "@assets/portrait-centered.png"
import lineChartImg from "@assets/line-chart.png"
import samsungNotifications from "@assets/samsung-notifications.mp4"
import HeroTitle from "@components/hero-title"
import { projects } from "@utils/constants"
import { ArrowUpRight, Code2, Sparkles } from "@lucide/astro"

const experience = [
	{
		role: "Software Developer",
		company: "Claxon Actuaries",
		period: "2023 — now",
		description:
			"Building Python and FastAPI systems, React interfaces, and AWS infrastructure with a focus on useful, dependable products.",
	},
	{
		role: "Independent Developer",
		company: "Freelance",
		period: "2022 — now",
		description:
			"Designing and shipping web products across TypeScript, Go, React, Figma, GitHub, and VPS infrastructure.",
	},
]
---

<BaseLayout>
	<div
		id="top"
		class="min-h-screen bg-[#f3f0e9] text-[#20201e] selection:bg-[#20201e] selection:text-[#f3f0e9]"
	>
		<main class="mx-auto w-full max-w-4xl px-4 sm:px-5">
			<section
				class="grid grid-cols-1 py-10 md:grid-cols-[minmax(0,1fr)_minmax(220px,0.38fr)] md:gap-x-8 md:py-14"
				aria-labelledby="intro-heading"
			>
				<HeroTitle client:load />

				<div
					class="max-w-xl text-[clamp(1.12rem,2vw,1.35rem)] leading-[1.55]"
				>
					<p>
						I’m <strong class="font-semibold"
							>Tawanda M. Nyoni</strong
						>, a software developer and interface designer. I care
						about how products look, feel, and work.
					</p>
				</div>

				<div
					class="mt-8 self-end border-l border-black/15 pl-4 text-sm leading-relaxed text-[#74716a] md:mt-0"
				>
					<span
						class="mb-3 block text-[0.68rem] font-bold text-[#20201e]"
					>
						Currently
					</span>
					<p>
						Senior Software Engineer at Claxon Actuaries, leading
						software teams and UI/UX design.
					</p>
				</div>
			</section>

			<section
				id="work"
				class="scroll-mt-8 py-12 md:py-14"
				aria-labelledby="work-title"
			>
				<div
					class="mb-8 grid grid-cols-[42px_1fr] items-start md:mb-10 md:grid-cols-[56px_minmax(180px,0.8fr)_minmax(240px,1fr)]"
				>
					<p
						class="text-[0.68rem] font-bold tracking-widest text-[#e25834]"
					>
						01
					</p>
					<h2
						id="work-title"
						class="font-serif text-[clamp(1.6rem,2.5vw,2.25rem)] leading-none font-normal tracking-[-0.035em]"
					>
						Selected work
					</h2>
					<p
						class="col-start-2 mt-3 max-w-md text-xs leading-relaxed text-[#74716a] md:col-start-auto md:mt-0 md:justify-self-end"
					>
						Products I’ve designed, built, or helped bring into the
						world.
					</p>
				</div>

				<div class="border-t border-black/15">
					{
						projects.map((project, index) => (
							<a
								class="group grid grid-cols-[30px_1fr_auto] items-center gap-3 border-b border-black/15 py-4 transition-all duration-200 hover:bg-white/40 hover:px-3 sm:grid-cols-[38px_1fr_auto] md:grid-cols-[56px_1fr_auto] md:py-5"
								href={project.link}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="font-serif text-[0.68rem] text-[#74716a] md:text-xs">
									{String(index + 1).padStart(2, "0")}
								</span>
								<span class="flex flex-col gap-1 md:flex-row md:items-baseline md:gap-6">
									<strong class="font-serif text-[clamp(1.3rem,2vw,1.75rem)] font-normal tracking-[-0.025em] md:min-w-52">
										{project.title}
									</strong>
									<span class="text-xs text-[#74716a] sm:text-sm">
										{project.description}
									</span>
								</span>
								<span class="flex items-center gap-5 text-xs text-[#74716a]">
									<span class="hidden md:inline">
										{project.year}
									</span>
									<ArrowUpRight class="size-5" />
								</span>
							</a>
						))
					}
				</div>
			</section>

			<section
				id="craft"
				class="scroll-mt-8 py-12 md:py-14"
				aria-labelledby="craft-title"
			>
				<div
					class="mb-8 grid grid-cols-[42px_1fr] items-start md:mb-10 md:grid-cols-[56px_minmax(180px,0.8fr)_minmax(240px,1fr)]"
				>
					<p
						class="text-[0.68rem] font-bold tracking-[0.1em] text-[#e25834]"
					>
						02
					</p>
					<h2
						id="craft-title"
						class="font-serif text-[clamp(1.6rem,2.5vw,2.25rem)] leading-none font-normal tracking-[-0.035em]"
					>
						Interface studies
					</h2>
					<p
						class="col-start-2 mt-3 max-w-md text-xs leading-relaxed text-[#74716a] md:col-start-auto md:mt-0 md:justify-self-end"
					>
						Small explorations in motion, feedback, data, and
						digital tactility.
					</p>
				</div>

				<div class="grid gap-4 md:grid-cols-[1.15fr_0.85fr]">
					<a
						class="group overflow-hidden rounded-sm border border-black/15 bg-white/35"
						href="/crafts/line-chart"
					>
						<div
							class="grid h-48 place-items-center overflow-hidden bg-[#e6e1d8] p-[clamp(1.5rem,4vw,3rem)] sm:h-56 md:h-64"
						>
							<img
								src={lineChartImg.src}
								alt="A line chart interface study"
								loading="lazy"
								class="w-full shadow-[0_24px_65px_rgba(35,32,27,0.14)] transition-transform duration-500 group-hover:scale-[1.025]"
							/>
						</div>
						<div class="relative flex flex-col gap-2 p-4">
							<span
								class="flex items-center gap-2 text-[0.68rem] tracking-[0.08em] text-[#74716a] uppercase"
							>
								<Sparkles class="size-4" /> Data interaction
							</span>
							<strong class="font-serif text-xl font-normal">
								Animated line chart
							</strong>
							<ArrowUpRight
								class="absolute right-4 bottom-4 size-5"
							/>
						</div>
					</a>

					<a
						class="group overflow-hidden rounded-sm border border-black/15 bg-white/35"
						href="/crafts/samsung-notifications"
					>
						<div
							class="grid h-48 place-items-center overflow-hidden bg-[#242321] sm:h-56 md:h-64"
						>
							<video
								src={samsungNotifications}
								autoplay
								loop
								muted
								playsinline
								aria-label="Samsung notification interface study"
								class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
							></video>
						</div>
						<div class="relative flex flex-col gap-2 p-4">
							<span
								class="flex items-center gap-2 text-[0.68rem] tracking-[0.08em] text-[#74716a] uppercase"
							>
								<Code2 class="size-4" /> Motion study
							</span>
							<strong class="font-serif text-xl font-normal">
								Samsung notifications
							</strong>
							<ArrowUpRight
								class="absolute right-4 bottom-4 size-5"
							/>
						</div>
					</a>
				</div>
			</section>

			<section
				id="about"
				class="scroll-mt-8 py-12 md:py-14"
				aria-labelledby="about-title"
			>
				<div
					class="mb-8 grid grid-cols-[42px_1fr] items-start md:mb-10 md:grid-cols-[56px_minmax(180px,0.8fr)_minmax(240px,1fr)]"
				>
					<p
						class="text-[0.68rem] font-bold tracking-[0.1em] text-[#e25834]"
					>
						03
					</p>
					<h2
						id="about-title"
						class="font-serif text-[clamp(1.6rem,2.5vw,2.25rem)] leading-none font-normal tracking-[-0.035em]"
					>
						A little about me
					</h2>
				</div>

				<div class="grid gap-8 md:grid-cols-[14rem_1fr] md:gap-10">
					<div>
						<img
							src={portraitUrl.src}
							alt="Portrait of Tawanda Nyoni"
							loading="lazy"
							class="aspect-2/3 w-full max-w-52 object-cover object-center contrast-[0.94] grayscale md:max-w-56"
						/>
						<p
							class="mt-4 font-serif text-sm text-[#74716a] italic"
						>
							Developer by practice. Designer by instinct.
						</p>
					</div>

					<div class="pt-4 leading-relaxed text-[#74716a]">
						<p
							class="mb-5 font-serif text-[clamp(1.15rem,1.8vw,1.4rem)] leading-snug tracking-[-0.015em] text-[#20201e]"
						>
							I care about the complete experience—from the shape
							of a database to the timing of a transition.
						</p>
						<p>
							My main tools are Python and TypeScript, with
							growing experience in Go. I use React and Figma to
							turn complex product requirements into interfaces
							that feel clear, fast, and human.
						</p>

						<div class="mt-8 border-t border-black/15">
							{
								experience.map((item) => (
									<div class="grid grid-cols-[1fr_auto] gap-x-5 gap-y-1 border-b border-black/15 py-3">
										<div class="flex flex-col">
											<strong class="text-sm text-[#20201e]">
												{item.role}
											</strong>
											<span class="text-xs">
												{item.company}
											</span>
										</div>
										<time class="text-xs">
											{item.period}
										</time>
										<p class="col-span-full mt-3 text-sm">
											{item.description}
										</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section
				id="writing"
				class="scroll-mt-8 py-12 md:py-14"
				aria-labelledby="writing-title"
			>
				<div
					class="mb-8 grid grid-cols-[42px_1fr] items-start md:mb-10 md:grid-cols-[56px_minmax(180px,0.8fr)_minmax(240px,1fr)]"
				>
					<p
						class="text-[0.68rem] font-bold tracking-[0.1em] text-[#e25834]"
					>
						04
					</p>
					<h2
						id="writing-title"
						class="font-serif text-[clamp(1.6rem,2.5vw,2.25rem)] leading-none font-normal tracking-[-0.035em]"
					>
						Notes on the work
					</h2>
					<p
						class="col-start-2 mt-3 max-w-md text-xs leading-relaxed text-[#74716a] md:col-start-auto md:mt-0 md:justify-self-end"
					>
						Infrequent thoughts about learning, engineering, and
						making software well.
					</p>
				</div>

				<a
					class="grid grid-cols-[1fr_auto] items-center gap-3 border-y border-black/15 py-4 md:grid-cols-[90px_minmax(240px,1fr)_minmax(200px,0.8fr)_auto] md:gap-5"
					href="/articles/how-to-learn-a-new-programming-language-or-framework"
				>
					<span
						class="text-[0.68rem] font-bold tracking-[0.09em] text-[#e25834] uppercase"
					>
						Learning
					</span>
					<strong
						class="col-start-1 font-serif text-lg font-normal md:col-start-auto md:text-xl"
					>
						How to learn a new programming language or framework
					</strong>
					<p
						class="col-start-1 text-sm leading-relaxed text-[#74716a] md:col-start-auto"
					>
						A practical guide to learning the deeper ideas—not only
						the syntax.
					</p>
					<ArrowUpRight
						class="col-start-2 row-span-3 row-start-1 size-5 md:col-start-auto md:row-span-1 md:row-start-auto"
					/>
				</a>
			</section>

			<section
				id="connect"
				class="scroll-mt-8 pt-12 pb-10 md:pt-14 md:pb-12"
			>
				<p
					class="text-[0.68rem] font-bold tracking-[0.1em] text-[#e25834]"
				>
					05
				</p>
				<h2
					id="connect-title"
					class="my-5 max-w-2xl font-serif text-[clamp(2.4rem,5vw,4rem)] leading-none font-normal tracking-[-0.05em]"
				>
					Have an interesting problem?
					<em class="block font-normal text-[#e25834]">Let’s talk.</em
					>
				</h2>

				<div class="flex flex-wrap gap-3">
					<a
						href="https://github.com/mtnyoni"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 rounded-full border border-black/15 px-5 py-3 text-sm transition-colors hover:bg-[#20201e] hover:text-[#f3f0e9]"
					>
						GitHub <ArrowUpRight class="size-4" />
					</a>
					<a
						href="https://linkedin.com/in/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 rounded-full border border-black/15 px-5 py-3 text-sm transition-colors hover:bg-[#20201e] hover:text-[#f3f0e9]"
					>
						LinkedIn <ArrowUpRight class="size-4" />
					</a>
					<a
						href="https://x.com/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 rounded-full border border-black/15 px-5 py-3 text-sm transition-colors hover:bg-[#20201e] hover:text-[#f3f0e9]"
					>
						X / Twitter <ArrowUpRight class="size-4" />
					</a>
				</div>

				<footer
					class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-black/15 pt-4 text-xs tracking-[0.04em] text-[#74716a] uppercase sm:mt-14 sm:flex-row"
				>
					<span>© {new Date().getFullYear()} Tawanda M Nyoni</span>
					<a href="#top">Back to top ↑</a>
				</footer>
			</section>
		</main>
	</div>
</BaseLayout>
