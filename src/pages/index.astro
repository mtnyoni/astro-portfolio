---
import BaseLayout from "@layouts/base-layout.astro"
import HeroTitle from "@components/hero-title"
import chart from "@assets/line-chart.png"
import notifications from "@assets/samsung-notifications.mp4"
import notificationPoster from "@assets/samsung-notifications-preview.jpg"
import { projects } from "@utils/constants"
import { ArrowUpRight } from "@lucide/astro"
import ProjectIcon from "@components/project-icon.astro"
---

<BaseLayout>
	<main
		id="top"
		class="leading-body text-body-copy mx-auto max-w-190 px-7 pt-24 pb-8 text-sm max-sm:max-w-125 max-sm:px-6 max-sm:pt-12 max-sm:pb-6"
	>
		<header class="ml-33.5 pb-13 max-sm:ml-0 max-sm:pb-5.5">
			<HeroTitle client:load />
			<div class="space-y-4.5">
				<p>
					I’m{" "}
					<strong class="font-medium text-mist-700">
						Tawanda M. Nyoni
					</strong>
					, Software Engineer and UI/UX Designer. I care <br
						class="hidden md:block"
					/> about how products look, feel, and work.
				</p>
				<p>
					<strong class="font-medium text-mist-700">
						Senior Software Developer
					</strong>
					at
					<strong class="font-medium text-mist-700">
						Claxon Business Solutions
					</strong>
					. Working across <br class="hidden md:block" /> engineering and
					design to make complex things feel simple.
				</p>
				<p>
					Linux fanatic. Writing Odin, Go, Python, and TypeScript.
					Always exploring.
				</p>
			</div>
			<nav
				class="leading-inherit text-navigation mt-6.5 flex gap-5.5 text-xs"
				aria-label="Portfolio sections"
			>
				<a
					class="ease-standard hover:text-link-hover flex items-center gap-1 transition-colors duration-200 motion-reduce:transition-none"
					href="#work"
				>
					Work
				</a>
				<a
					class="ease-standard hover:text-link-hover flex items-center gap-1 transition-colors duration-200 motion-reduce:transition-none"
					href="#craft"
				>
					Craft
				</a>
				<a
					class="ease-standard hover:text-link-hover flex items-center gap-1 transition-colors duration-200 motion-reduce:transition-none"
					href="#writing"
				>
					Writing
				</a>
				<span class="text-separator" aria-hidden="true"> | </span>
				<a
					class="ease-standard hover:text-link-hover flex items-center gap-1 transition-colors duration-200 motion-reduce:transition-none"
					href="#connect"
				>
					Connect <ArrowUpRight size={13} />
				</a>
			</nav>
		</header>

		<section
			id="work"
			class="grid-cols-portfolio grid scroll-mt-8 gap-6 py-7.5 max-sm:grid-cols-1 max-sm:gap-4.25 max-sm:py-6.5"
			aria-labelledby="work-title"
		>
			<h2
				class="leading-inherit text-section-label max-sm:text-link pt-0.75 text-xs font-normal max-sm:font-medium"
				id="work-title"
			>
				Selected work
			</h2>
			<div class="-mt-2.5 min-w-0">
				{
					projects.map((project, index) => (
						<a
							class="rounded-project ease-standard hover:bg-project-hover hover:text-link-hover -mx-2.5 flex items-center gap-3.5 px-2.5 py-3 transition-colors duration-200 motion-reduce:transition-none"
							href={project.link}
							target="_blank"
							rel="noopener noreferrer"
						>
							<ProjectIcon
								kind={index === 0 ? "rental" : "finance"}
							/>
							<span class="flex flex-col gap-px">
								<>
									<span class="flex items-center gap-1.5 font-medium text-mist-700">
										{project.title}{" "}
										<ArrowUpRight
											class="text-link-icon"
											size={13}
										/>
									</span>
									<span class="leading-inherit text-xs">
										{project.description}
									</span>
								</>
							</span>
							<span class="text-caption text-metadata ml-auto tabular-nums">
								{project.year}
							</span>
						</a>
					))
				}
			</div>
		</section>

		<section
			id="craft"
			class="grid-cols-portfolio grid scroll-mt-8 gap-6 py-7.5 max-sm:grid-cols-1 max-sm:gap-4.25 max-sm:py-6.5"
			aria-labelledby="craft-title"
		>
			<h2
				class="leading-inherit text-section-label max-sm:text-link pt-0.75 text-xs font-normal max-sm:font-medium"
				id="craft-title"
			>
				Craft
			</h2>
			<div class="min-w-0">
				<p class="mb-5 max-w-102.5">
					Little experiments exploring how designs come about, and
					laying out my imagination.
				</p>
				<div class="max-xs:grid-cols-1 grid grid-cols-2 gap-1">
					<a
						class="group ease-standard hover:text-link-hover transition-colors duration-200 motion-reduce:transition-none"
						href="/crafts/line-chart"
					>
						<div
							class="bg-chart-surface max-xs:h-55 relative grid h-50 place-items-center overflow-hidden rounded-xl max-sm:h-45"
						>
							<div
								class="absolute inset-1 overflow-hidden rounded-lg"
							>
								<img
									class="ease-standard h-full w-full rounded-lg object-cover transition-transform duration-300 motion-safe:group-hover:scale-105 motion-reduce:transition-none"
									src={chart.src}
									width={chart.width}
									height={chart.height}
									alt="Interactive line chart with a soft green area fill"
									loading="lazy"
								/>
							</div>
						</div>
						<div class="block pt-1">
							<h3
								class="flex items-center gap-1.25 text-xs text-mist-500"
							>
								Animated line chart
							</h3>
						</div>
					</a>
					<div class="group">
						<div
							class="border-preview-border bg-video-surface max-xs:h-55 relative h-50 overflow-hidden rounded-xl border max-sm:h-45"
						>
							<div
								class="absolute inset-1 overflow-hidden rounded-lg"
							>
								<video
									class="size-full rounded-lg object-cover"
									id="notification-preview"
									poster={notificationPoster.src}
									src={notifications}
									muted
									loop
									playsinline
									preload="metadata"
									aria-label="Samsung notification animation preview"
								></video>
								<button
									class="bg-preview-control text-micro text-control-copy shadow-preview absolute bottom-2.5 left-2.5 flex cursor-pointer items-center gap-3.5 rounded-md px-2.25 py-1.25"
									id="preview-toggle"
									type="button"
									aria-controls="notification-preview"
									aria-pressed="false"
								>
									Play preview{" "}
									<span aria-hidden="true">▷</span>
								</button>
							</div>
						</div>
						<a
							class="ease-standard hover:text-link-hover block pt-1 transition-colors duration-200 motion-reduce:transition-none"
							href="/crafts/samsung-notifications"
						>
							<h3
								class="flex items-center gap-1.25 text-xs text-mist-500"
							>
								Samsung notifications
							</h3>
						</a>
					</div>
				</div>
			</div>
		</section>

		<section
			id="writing"
			class="grid-cols-portfolio grid scroll-mt-8 gap-6 py-7.5 max-sm:grid-cols-1 max-sm:gap-4.25 max-sm:py-6.5"
			aria-labelledby="writing-title"
		>
			<h2
				class="leading-inherit text-section-label max-sm:text-link pt-0.75 text-xs font-normal max-sm:font-medium"
				id="writing-title"
			>
				Writing
			</h2>
			<div class="min-w-0">
				<p class="mb-2 max-w-102.5">
					My two cents on how good software is engineered.
				</p>
				<a
					class="ease-standard hover:text-link-hover flex items-center gap-5 transition-colors duration-200 motion-reduce:transition-none"
					href="/articles/how-to-learn-a-new-programming-language-or-framework"
				>
					<div class="-space-y-1.5">
						<h3
							class="leading-heading text-sm font-medium text-mist-700"
						>
							How to learn a new programming language or framework
						</h3>
						<p class="leading-inherit mt-1.25 text-xs">
							Looking beyond the syntax.
						</p>
					</div>
					<ArrowUpRight class="ml-auto shrink-0" size={17} />
				</a>
			</div>
		</section>

		<section
			id="connect"
			class="grid-cols-portfolio grid scroll-mt-8 gap-6 py-7.5 max-sm:grid-cols-1 max-sm:gap-4.25 max-sm:py-6.5"
			aria-labelledby="connect-title"
		>
			<h2
				class="leading-inherit text-section-label max-sm:text-link pt-0.75 text-xs font-normal max-sm:font-medium"
				id="connect-title"
			>
				Elsewhere
			</h2>
			<div class="min-w-0">
				<p>
					Have something in mind, or big ideas that need to be turned
					<br class="hidden md:block" /> into reality? Hit me up.
				</p>
				<div class="mt-3 flex flex-wrap gap-5.5">
					<a
						class="leading-inherit text-link ease-standard hover:text-link-hover flex items-center gap-1.5 text-xs transition-colors duration-200 motion-reduce:transition-none"
						href="https://github.com/mtnyoni"
						target="_blank"
						rel="noopener noreferrer"
					>
						GitHub
						<ArrowUpRight size={12} />
					</a>
					<a
						class="leading-inherit text-link ease-standard hover:text-link-hover flex items-center gap-1.5 text-xs transition-colors duration-200 motion-reduce:transition-none"
						href="https://linkedin.com/in/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
					>
						LinkedIn
						<ArrowUpRight size={12} />
					</a>
					<a
						class="leading-inherit text-link ease-standard hover:text-link-hover flex items-center gap-1.5 text-xs transition-colors duration-200 motion-reduce:transition-none"
						href="https://x.com/tmnyoni"
						target="_blank"
						rel="noopener noreferrer"
					>
						X.com
						<ArrowUpRight size={12} />
					</a>
				</div>
			</div>
		</section>
		<footer
			class="border-footer-border text-micro text-footer-copy mt-10 ml-33.5 flex justify-between gap-4 border-t pt-5 max-sm:ml-0"
		>
			<span>© {new Date().getFullYear()} Tawanda Nyoni</span>
		</footer>
	</main>
</BaseLayout>

<script>
	const video = document.querySelector<HTMLVideoElement>(
		"#notification-preview"
	)
	const toggle = document.querySelector<HTMLButtonElement>("#preview-toggle")
	if (video && toggle) {
		const update = () => {
			toggle.setAttribute("aria-pressed", String(!video.paused))
			toggle.innerHTML = video.paused
				? 'Play preview <span aria-hidden="true">▷</span>'
				: 'Pause preview <span aria-hidden="true">Ⅱ</span>'
		}
		toggle.addEventListener("click", async () => {
			if (video.paused) {
				try {
					await video.play()
				} catch {
					toggle.textContent = "Preview unavailable"
				}
			} else video.pause()
		})
		video.addEventListener("play", update)
		video.addEventListener("pause", update)
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) video.pause()
		})
	}
</script>
